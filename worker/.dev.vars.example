# Local secrets for `pnpm worker:dev`.
#
# Wrangler reads `.dev.vars` from the directory holding the Wrangler config
# (worker/wrangler.toml), so copy this file to `worker/.dev.vars` and fill it in.
# The real file is git-ignored — never commit it.
#
# In production these live as Worker secrets:
#     cd worker && pnpm dlx wrangler secret put TYPESAFE_API_KEY

# TypeSafe Jev API key. Required. Never expose this to the browser.
TYPESAFE_API_KEY=

# Optional. Overrides the TypeSafe API root for testing against a proxy.
# Defaults to https://api.typesafe.ai when unset.
TYPESAFE_API_BASE=https://api.typesafe.ai
